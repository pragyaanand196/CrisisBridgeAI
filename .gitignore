# ==============================================================================
# CrisisBridge AI - Git Ignore Rules
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
ENV/
env/

# Node / Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.vite/
.vite-temp/
frontend/.vite/
frontend/.vite-temp/
*.local

# Databases & Backups (CRITICAL: protect live and historical database files)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.backup*
*backup*
crisisbridge.db*
backend/crisisbridge.db*

# Environment and Secret Files
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.pem
*.key
*.cert

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
