# ==============================================================================
# CrisisBridge AI - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in your backend directory or workspace root.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Application Metadata
PROJECT_NAME="CrisisBridge AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration
# For local SQLite development (default):
DATABASE_URL="sqlite:///./crisisbridge.db"
# For production PostgreSQL with PostGIS:
# DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>"

# JWT Authentication
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY="your-secure-jwt-secret-key-change-this-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider API Keys (Optional)
# If left blank, CrisisBridge AI automatically falls back to its deterministic rule engine
OPENAI_API_KEY=""
GEMINI_API_KEY=""
